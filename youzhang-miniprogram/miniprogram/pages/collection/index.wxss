.category-row {
  display: flex;
  gap: 12rpx;
  margin-top: 30rpx;
  overflow-x: auto;
}

.category-pill {
  flex: 0 0 auto;
  min-width: 104rpx;
  height: 56rpx;
  border-radius: 999rpx;
  border: 0;
  background: #ffffff;
  color: #69747c;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
}

.category-pill.active {
  background: #172026;
  color: #ffffff;
}

.cabinet {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
  margin-top: 30rpx;
  margin-bottom: 34rpx;
}

.collection-card {
  overflow: hidden;
  border-radius: 28rpx;
}

.item-display {
  height: 190rpx;
  position: relative;
  border-bottom: 0;
}

.item-display::after {
  content: "";
  position: absolute;
  left: 36rpx;
  right: 36rpx;
  bottom: 24rpx;
  height: 22rpx;
  border-radius: 50%;
  background: rgba(23, 32, 38, 0.16);
}

.display-shine {
  position: absolute;
  left: 24rpx;
  top: 24rpx;
  width: 48rpx;
  height: 80rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.38);
}

.item-body {
  min-height: 138rpx;
  padding: 18rpx;
}

.item-top {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.item-name {
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.3;
}

.item-series {
  display: block;
  margin-top: 14rpx;
  color: #69747c;
  font-size: 23rpx;
  line-height: 1.35;
}
