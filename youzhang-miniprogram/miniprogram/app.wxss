page {
  min-height: 100vh;
  background: #f6f8fb;
  color: #172026;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  font-size: 28rpx;
}

view,
text,
button,
input,
textarea {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  line-height: 1;
  background: transparent;
}

.page-shell {
  min-height: 100vh;
  padding: 34rpx 28rpx 54rpx;
}

.page-title {
  font-size: 52rpx;
  font-weight: 800;
  letter-spacing: 0;
  color: #172026;
}

.page-subtitle {
  margin-top: 10rpx;
  color: #69747c;
  font-size: 26rpx;
  line-height: 1.5;
}

.section {
  margin-top: 36rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 750;
  color: #172026;
}

.section-action {
  color: #0f766e;
  font-size: 24rpx;
  font-weight: 650;
}

.card {
  border: 2rpx solid rgba(23, 32, 38, 0.06);
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 18rpx 48rpx rgba(19, 34, 43, 0.07);
}

.tag {
  display: inline-flex;
  align-items: center;
  min-height: 44rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #e7f7f4;
  color: #0f766e;
  font-size: 22rpx;
  font-weight: 650;
}

.tag.warm {
  background: #fff1e8;
  color: #e2552c;
}

.primary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 22rpx;
  background: #172026;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 750;
  box-shadow: 0 16rpx 32rpx rgba(23, 32, 38, 0.18);
}
