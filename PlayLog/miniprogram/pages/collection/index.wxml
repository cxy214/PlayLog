<view class="page-shell collection-page">
  <view class="page-title">收藏柜</view>
  <view class="page-subtitle">盲盒、文具、游戏周边都放在这里，心愿和重复款也不会忘。</view>

  <view class="category-row">
    <view class="category-pill {{index === 0 ? 'active' : ''}}" wx:for="{{categories}}" wx:key="*this">{{item}}</view>
  </view>

  <view class="cabinet">
    <view class="collection-card card" wx:for="{{collectionItems}}" wx:key="id">
      <view class="item-display" style="background: {{item.accentColor}};">
        <view class="display-shine"></view>
      </view>
      <view class="item-body">
        <view class="item-top">
          <text class="item-name">{{item.name}}</text>
          <text class="tag warm">{{item.status}}</text>
        </view>
        <text class="item-series">{{item.series}} · {{item.category}}</text>
      </view>
    </view>
  </view>

  <button class="primary-button">收进收藏柜</button>
</view>
