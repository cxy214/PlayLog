/* ─── 设计 Token ───────────────────────────────────────────
   风格：手帐拼贴 × 文艺莫兰迪 × 线条插画
   底色：冷白    #F5F5F5
   主色：莫兰迪绿 #5BAF85  （降饱和，更雅）
   辅色：莫兰迪橙 #D4896A  /  莫兰迪黄 #C9A84C
   文字：深墨绿  #1A2E22  /  中灰绿  #7A9088  /  浅灰绿  #B0C4BC
   卡片：纯白    #FFFFFF  + 细边框
   文艺感来源：莫兰迪色调 + 疏朗字间距 + 斜体标签 + 竖线装饰 + 胶片叠色
──────────────────────────────────────────────────────────── */

page {
  min-height: 100vh;
  background: #F5F5F5;
  color: #1A2E22;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Segoe UI", sans-serif;
  font-size: 28rpx;
}

view,
text,
button,
input,
textarea {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  line-height: 1;
  background: transparent;
}

/* ─── 页面容器 ─── */
.page-shell {
  min-height: 100vh;
  padding: 40rpx 28rpx 80rpx;
}

/* ─── 标题系统（文艺排版：疏朗 + 竖线装饰） ─── */
.page-title {
  font-size: 50rpx;
  font-weight: 700;           /* 从 800 降到 700，更克制 */
  letter-spacing: 2rpx;       /* 加大字间距，杂志感 */
  color: #1A2E22;
  line-height: 1.25;
}

.page-subtitle {
  margin-top: 12rpx;
  color: #9AADA6;
  font-size: 24rpx;
  line-height: 1.8;           /* 更大行高，更透气 */
  letter-spacing: 1rpx;
}

/* ─── Section ─── */
.section {
  margin-top: 48rpx;          /* 加大 section 间距，留白更足 */
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

/* section 标题：左侧竖线装饰（替代短横线，更文艺） */
.section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1A2E22;
  letter-spacing: 2rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.section-title::before {
  content: "";
  display: inline-block;
  width: 3rpx;               /* 竖线，比横线更有杂志感 */
  height: 28rpx;
  border-radius: 999rpx;
  background: #5BAF85;
  flex-shrink: 0;
}

.section-action {
  color: #5BAF85;
  font-size: 23rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  border-bottom: 1rpx solid rgba(91, 175, 133, 0.35);
  padding-bottom: 2rpx;
}

/* ─── 卡片基础 ─── */
.card {
  border: 1rpx solid #EBEBEB;
  border-radius: 28rpx;
  background: #FFFFFF;
  box-shadow:
    0 2rpx 8rpx rgba(0, 0, 0, 0.04),
    0 10rpx 28rpx rgba(0, 0, 0, 0.05);
}

/* ─── 印章标签系统（文艺版：斜体 + 莫兰迪色） ─── */

/* 基础印章：莫兰迪绿 */
.tag {
  display: inline-flex;
  align-items: center;
  min-height: 44rpx;
  padding: 0 18rpx;
  border-radius: 6rpx;
  border: 1.5rpx solid #5BAF85;
  background: transparent;
  color: #5BAF85;
  font-size: 20rpx;
  font-weight: 700;
  font-style: italic;         /* 斜体，手写便签感 */
  letter-spacing: 3rpx;
  transform: rotate(-1deg);
  position: relative;
}

/* 印章内框线 */
.tag::before {
  content: "";
  position: absolute;
  inset: 3rpx;
  border: 1rpx solid rgba(91, 175, 133, 0.25);
  border-radius: 4rpx;
  pointer-events: none;
}

/* 印章：莫兰迪橙 */
.tag.warm {
  border-color: #D4896A;
  color: #D4896A;
  transform: rotate(1.5deg);
}

.tag.warm::before {
  border-color: rgba(212, 137, 106, 0.25);
}

/* 印章：莫兰迪黄 */
.tag.yellow {
  border-color: #C9A84C;
  color: #C9A84C;
  transform: rotate(-0.8deg);
}

.tag.yellow::before {
  border-color: rgba(201, 168, 76, 0.25);
}

/* 印章：灰色（搁置） */
.tag.muted {
  border-color: #B0C4BC;
  color: #B0C4BC;
  transform: rotate(1deg);
}

/* ─── 主按钮 ─── */
.primary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 92rpx;
  border-radius: 16rpx;
  background: #1A2E22;
  color: #FFFFFF;
  font-size: 27rpx;
  font-weight: 700;
  letter-spacing: 4rpx;       /* 更大字间距，更有质感 */
  box-shadow:
    0 4rpx 0 #0D1A12,
    0 8rpx 24rpx rgba(26, 46, 34, 0.2);
  position: relative;
  overflow: hidden;
}

/* 按钮左侧莫兰迪绿竖条 */
.primary-button::before {
  content: "";
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 6rpx;
  background: #5BAF85;
}

/* ─── 纸纹背景辅助类 ─── */
.paper-bg {
  background-color: #F5F5F5;
  background-image:
    repeating-linear-gradient(
      transparent,
      transparent 47rpx,
      rgba(0, 0, 0, 0.04) 47rpx,
      rgba(0, 0, 0, 0.04) 48rpx
    );
}

/* ─── 撕纸边缘效果（用于 Hero 底部） ─── */
.torn-edge {
  position: relative;
}

.torn-edge::after {
  content: "";
  position: absolute;
  left: -4rpx;
  right: -4rpx;
  bottom: -12rpx;
  height: 24rpx;
  background: #F5F5F5;
  clip-path: polygon(
    0% 0%, 3% 100%, 6% 20%, 9% 90%, 12% 10%,
    15% 80%, 18% 5%, 21% 95%, 24% 15%, 27% 85%,
    30% 0%, 33% 100%, 36% 20%, 39% 90%, 42% 10%,
    45% 80%, 48% 5%, 51% 95%, 54% 15%, 57% 85%,
    60% 0%, 63% 100%, 66% 20%, 69% 90%, 72% 10%,
    75% 80%, 78% 5%, 81% 95%, 84% 15%, 87% 85%,
    90% 0%, 93% 100%, 96% 20%, 100% 60%, 100% 0%
  );
  z-index: 2;
}
