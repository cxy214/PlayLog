/* ─── 设计 Token ───────────────────────────────────────────
   风格：喜茶平面直角 × 手帐印章点缀
   底色：纯白    #FFFFFF
   主色：墨黑    #1A1A1A
   强调：莫兰迪绿 #5BAF85  （仅用于标签/印章/竖条）
   辅色：莫兰迪橙 #D4896A  /  莫兰迪黄 #C9A84C
   文字：主文字  #1A1A1A  /  次文字  #888888  /  占位  #BBBBBB
   分隔：细线    #EBEBEB  /  虚线  #E0E0E0
   核心原则：无圆角卡片、无阴影、靠细线+留白划分层级
             按钮直角黑底、标签小圆角保留手帐感
──────────────────────────────────────────────────────────── */

page {
  min-height: 100vh;
  background: #FFFFFF;
  color: #1A1A1A;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Segoe UI", sans-serif;
  font-size: 28rpx;
}

view,
text,
button,
input,
textarea {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  line-height: 1;
  background: transparent;
}

/* ─── 页面容器 ─── */
.page-shell {
  min-height: 100vh;
  padding: 40rpx 32rpx 100rpx;
}

/* ─── 标题系统 ─── */
.page-title {
  font-size: 48rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: #1A1A1A;
  line-height: 1.2;
}

.page-subtitle {
  margin-top: 10rpx;
  color: #888888;
  font-size: 24rpx;
  line-height: 1.7;
  letter-spacing: 0.5rpx;
}

/* ─── Section ─── */
.section {
  margin-top: 48rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #EBEBEB;
}

.section-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #1A1A1A;
  letter-spacing: 2rpx;
  text-transform: uppercase;
}

/* 去掉 ::before 装饰，靠下划线分隔线本身 */
.section-title::before {
  display: none;
}

.section-action {
  color: #888888;
  font-size: 22rpx;
  font-weight: 400;
  letter-spacing: 0.5rpx;
}

/* ─── 卡片：平面化，无阴影无圆角 ─── */
.card {
  border-top: 1rpx solid #EBEBEB;
  border-bottom: 1rpx solid #EBEBEB;
  border-radius: 0;
  background: #FFFFFF;
}

/* ─── 印章标签系统（保留手帐感，小圆角+斜体） ─── */
.tag {
  display: inline-flex;
  align-items: center;
  height: 40rpx;
  padding: 0 14rpx;
  border-radius: 4rpx;
  border: 1rpx solid #5BAF85;
  background: transparent;
  color: #5BAF85;
  font-size: 19rpx;
  font-weight: 700;
  font-style: italic;
  letter-spacing: 2rpx;
}

/* 去掉内框线，保持简洁 */
.tag::before {
  display: none;
}

.tag.warm {
  border-color: #D4896A;
  color: #D4896A;
}

.tag.yellow {
  border-color: #C9A84C;
  color: #C9A84C;
}

.tag.muted {
  border-color: #BBBBBB;
  color: #BBBBBB;
}

/* ─── 主按钮：喜茶直角黑底 ─── */
.primary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 0;                /* 直角 */
  background: #1A1A1A;
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  box-shadow: none;                /* 无阴影 */
  position: relative;
  overflow: hidden;
}

/* 去掉左侧竖条 */
.primary-button::before {
  display: none;
}

/* ─── 纸纹背景辅助类（保留极淡横线） ─── */
.paper-bg {
  background-color: #FFFFFF;
  background-image:
    repeating-linear-gradient(
      transparent,
      transparent 47rpx,
      rgba(0, 0, 0, 0.03) 47rpx,
      rgba(0, 0, 0, 0.03) 48rpx
    );
}

/* ─── 撕纸边缘（保留，但颜色改白） ─── */
.torn-edge {
  position: relative;
}

.torn-edge::after {
  content: "";
  position: absolute;
  left: -4rpx;
  right: -4rpx;
  bottom: -12rpx;
  height: 24rpx;
  background: #FFFFFF;
  clip-path: polygon(
    0% 0%, 3% 100%, 6% 20%, 9% 90%, 12% 10%,
    15% 80%, 18% 5%, 21% 95%, 24% 15%, 27% 85%,
    30% 0%, 33% 100%, 36% 20%, 39% 90%, 42% 10%,
    45% 80%, 48% 5%, 51% 95%, 54% 15%, 57% 85%,
    60% 0%, 63% 100%, 66% 20%, 69% 90%, 72% 10%,
    75% 80%, 78% 5%, 81% 95%, 84% 15%, 87% 85%,
    90% 0%, 93% 100%, 96% 20%, 100% 60%, 100% 0%
  );
  z-index: 2;
}
