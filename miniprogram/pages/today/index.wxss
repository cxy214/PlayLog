.today-page {
  padding-bottom: 80rpx;
}

/* ─── Hero：平面化，无卡片感 ─── */
.hero {
  display: flex;
  justify-content: space-between;
  align-items: stretch;
  gap: 20rpx;
  min-height: 260rpx;
  padding: 40rpx 0 40rpx;
  border-bottom: 1rpx solid #EBEBEB;
  background: #FFFFFF;
  position: relative;
}

/* 去掉纸纹横线容器，改用极淡背景线 */
.hero-lines {
  display: none;
}

.hero-line {
  display: none;
}

.hero-copy {
  flex: 1;
  position: relative;
  z-index: 1;
}

/* 日期：印章风格保留，但更克制 */
.date-stamp {
  display: inline-flex;
  align-items: center;
  height: 38rpx;
  padding: 0 14rpx;
  border: 1rpx solid #D4896A;
  border-radius: 4rpx;
  color: #D4896A;
  font-size: 19rpx;
  font-weight: 700;
  font-style: italic;
  letter-spacing: 3rpx;
  margin-bottom: 20rpx;
  transform: rotate(-1deg);
  position: relative;
}

/* 去掉内框线 */
.date-stamp::before {
  display: none;
}

/* Hero 标题 */
.hero-title {
  font-size: 52rpx !important;
  font-weight: 700 !important;
  letter-spacing: 0rpx !important;
  line-height: 1.2 !important;
}

/* ─── Hero 插画区（保留，是手帐特色） ─── */
.hero-doodle {
  width: 160rpx;
  flex: 0 0 160rpx;
  align-self: center;
  height: 190rpx;
  position: relative;
  z-index: 1;
}

.doodle-card {
  position: absolute;
  right: 0;
  top: 8rpx;
  width: 130rpx;
  height: 155rpx;
  border: 1.5rpx solid #5BAF85;
  border-radius: 4rpx;           /* 直角化 */
  background: #FFFFFF;
  transform: rotate(3deg);
  box-shadow: none;
}

.doodle-line {
  width: 68rpx;
  height: 3rpx;
  border-radius: 0;
  margin: 20rpx 0 0 18rpx;
  background: #D4E8DC;
}

.doodle-line.wide {
  width: 92rpx;
  margin-top: 34rpx;
}

.doodle-spark {
  position: absolute;
  right: 16rpx;
  top: 14rpx;
  width: 20rpx;
  height: 20rpx;
}

.doodle-spark::before,
.doodle-spark::after {
  content: "";
  position: absolute;
  background: #D4896A;
  border-radius: 0;
}

.doodle-spark::before {
  width: 20rpx;
  height: 2rpx;
  top: 50%;
  left: 0;
  transform: translateY(-50%);
}

.doodle-spark::after {
  width: 2rpx;
  height: 20rpx;
  left: 50%;
  top: 0;
  transform: translateX(-50%);
}

.doodle-flower {
  position: absolute;
  left: 16rpx;
  bottom: 20rpx;
  width: 48rpx;
  height: 48rpx;
}

.doodle-flower view {
  position: absolute;
  width: 18rpx;
  height: 18rpx;
  border: 1.5rpx solid #D4896A;
  border-radius: 50%;
}

.doodle-flower view:nth-child(1) { left: 15rpx; top: 0; }
.doodle-flower view:nth-child(2) { right: 0; top: 15rpx; }
.doodle-flower view:nth-child(3) { left: 15rpx; bottom: 0; }
.doodle-flower view:nth-child(4) { left: 0; top: 15rpx; }

.doodle-pad {
  position: absolute;
  left: 2rpx;
  bottom: 0;
  width: 80rpx;
  height: 64rpx;
  border: 1.5rpx solid #C9A84C;
  border-radius: 4rpx;           /* 直角化 */
  background: rgba(255, 248, 220, 0.8);
  transform: rotate(-6deg);
  box-shadow: none;
}

.doodle-pad::after {
  content: "";
  position: absolute;
  left: 12rpx;
  top: 18rpx;
  width: 46rpx;
  height: 2rpx;
  border-radius: 0;
  background: rgba(201, 168, 76, 0.4);
  box-shadow: 0 13rpx 0 rgba(201, 168, 76, 0.25);
}

.doodle-clip {
  position: absolute;
  right: 50rpx;
  top: -12rpx;
  width: 16rpx;
  height: 40rpx;
  border: 2rpx solid #BBBBBB;
  border-radius: 999rpx;
  border-bottom: none;
}

.doodle-clip::after {
  content: "";
  position: absolute;
  left: 3rpx;
  top: 5rpx;
  width: 6rpx;
  height: 24rpx;
  border: 2rpx solid #BBBBBB;
  border-radius: 999rpx;
  border-bottom: none;
}

/* ─── 快捷操作 ─── */
.quick-panel {
  display: flex;
  gap: 12rpx;
  margin-top: 28rpx;
}

.record-button {
  flex: 1;
}

.quick-actions {
  display: flex;
  gap: 10rpx;
  flex: 0 0 auto;
}

.quick-action {
  min-width: 100rpx;
  height: 88rpx;
  border: 1rpx solid #EBEBEB;
  border-radius: 0;              /* 直角 */
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  background: #FFFFFF;
  color: #888888;
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  box-shadow: none;
}

.quick-icon {
  width: 30rpx;
  height: 24rpx;
  position: relative;
}

.icon-camera {
  border: 1.5rpx solid #888888;
  border-radius: 3rpx;
}

.icon-camera::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 11rpx;
  height: 11rpx;
  border: 1.5rpx solid #888888;
  border-radius: 50%;
}

.icon-camera::after {
  content: "";
  position: absolute;
  left: 5rpx;
  top: -5rpx;
  width: 9rpx;
  height: 5rpx;
  border: 1.5rpx solid #888888;
  border-bottom: none;
  border-radius: 2rpx 2rpx 0 0;
}

.icon-star {
  width: 26rpx;
  height: 26rpx;
  border: 1.5rpx solid #C9A84C;
  transform: rotate(45deg);
  border-radius: 2rpx;
}

/* ─── 统计条 ─── */
.stats-strip {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 0;                        /* 无间距，靠细线分隔 */
  border: 1rpx solid #EBEBEB;
  border-radius: 0;
}

.stat-card {
  min-height: 148rpx;
  padding: 20rpx 18rpx 20rpx;
  border-right: 1rpx solid #EBEBEB;
  border-radius: 0;
  background: #FFFFFF;
  box-shadow: none;
  position: relative;
  overflow: hidden;
}

.stat-card:last-child {
  border-right: none;
}

/* 顶部彩色细线（替代胶带，更克制） */
.stat-tape {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3rpx;
  margin: 0;
  border-radius: 0;
  background: #5BAF85;
  opacity: 1;
}

.stat-card:nth-child(2) .stat-tape { background: #D4896A; }
.stat-card:nth-child(3) .stat-tape { background: #C9A84C; }

.stat-value {
  display: block;
  margin-top: 8rpx;
  font-size: 36rpx;
  font-weight: 700;
  color: #1A1A1A;
  letter-spacing: -1rpx;
}

.stat-label {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  font-weight: 600;
  color: #888888;
  letter-spacing: 1rpx;
}

.stat-hint {
  display: block;
  margin-top: 6rpx;
  color: #BBBBBB;
  font-size: 18rpx;
  line-height: 1.5;
}

/* ─── 最近在玩 ─── */
.game-row {
  width: 100%;
  white-space: nowrap;
}

.game-card {
  display: inline-block;
  width: 260rpx;
  margin-right: 16rpx;
  overflow: hidden;
  vertical-align: top;
  border: 1rpx solid #EBEBEB;
  border-radius: 0;              /* 直角 */
  background: #FFFFFF;
  box-shadow: none;
}

.cover {
  height: 156rpx;
  padding: 20rpx;
  color: #FFFFFF;
  position: relative;
  overflow: hidden;
}

/* 胶片叠色保留 */
.cover::before {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(
    135deg,
    rgba(255, 240, 210, 0.15) 0%,
    rgba(180, 120, 80, 0.1) 100%
  );
  mix-blend-mode: multiply;
  z-index: 1;
}

.cover::after {
  content: "";
  position: absolute;
  right: -30rpx;
  bottom: -30rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.07);
  z-index: 2;
}

.cover-noise {
  position: absolute;
  left: 20rpx;
  bottom: 16rpx;
  width: 48rpx;
  height: 2rpx;
  border-radius: 0;
  background: rgba(255, 255, 255, 0.4);
  z-index: 3;
}

.cover-title {
  display: block;
  max-width: 180rpx;
  white-space: normal;
  font-size: 25rpx;
  font-weight: 700;
  letter-spacing: 0.5rpx;
  line-height: 1.3;
  position: relative;
  z-index: 3;
  text-shadow: 0 1rpx 6rpx rgba(0, 0, 0, 0.3);
}

.cover-figure {
  position: absolute;
  right: 16rpx;
  bottom: 20rpx;
  width: 22rpx;
  height: 34rpx;
  z-index: 3;
}

.cover-figure::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 0;
  transform: translateX(-50%);
  width: 11rpx;
  height: 11rpx;
  border: 1.5rpx solid rgba(255,255,255,0.6);
  border-radius: 50%;
}

.cover-figure::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 13rpx;
  transform: translateX(-50%);
  width: 2rpx;
  height: 13rpx;
  background: rgba(255,255,255,0.6);
  border-radius: 999rpx;
  box-shadow:
    -6rpx 5rpx 0 rgba(255,255,255,0.6),
     6rpx 5rpx 0 rgba(255,255,255,0.6),
    -5rpx 3rpx 0 rgba(255,255,255,0.6),
     5rpx 3rpx 0 rgba(255,255,255,0.6);
}

.game-meta {
  padding: 16rpx 16rpx 18rpx;
  border-top: 1rpx solid #EBEBEB;
}

.game-title {
  display: block;
  font-size: 25rpx;
  font-weight: 700;
  white-space: normal;
  color: #1A1A1A;
  letter-spacing: 0.5rpx;
}

.game-progress {
  display: block;
  margin-top: 7rpx;
  color: #888888;
  font-size: 21rpx;
}

.tag-line {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 12rpx;
}

/* ─── 今日碎片 ─── */
.log-card {
  display: flex;
  align-items: stretch;
  gap: 0;
  margin-bottom: 0;
  border-radius: 0;
  border-bottom: 1rpx solid #EBEBEB;
  padding: 0;
  overflow: hidden;
}

/* 左侧彩色竖条 */
.log-accent {
  width: 4rpx;
  flex: 0 0 4rpx;
  background: #5BAF85;
  border-radius: 0;
}

/* 卡片主体内容 */
.log-body {
  flex: 1;
  min-width: 0;
  padding: 24rpx 0 24rpx 20rpx;
}

.log-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.log-top-left {
  flex: 1;
  min-width: 0;
}

.log-meta-row {
  display: flex;
  align-items: center;
  gap: 6rpx;
  margin-top: 5rpx;
}

.log-progress {
  font-size: 20rpx;
  color: #BBBBBB;
  letter-spacing: 0.5rpx;
}

.log-top-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
  flex: 0 0 auto;
}

/* 截图数量角标 */
.log-img-badge {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.log-img-badge-icon {
  font-size: 18rpx;
  color: #BBBBBB;
}

.log-img-badge-count {
  font-size: 18rpx;
  color: #BBBBBB;
  letter-spacing: 0.5rpx;
}

.log-game {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #1A1A1A;
  letter-spacing: 0.5rpx;
}

.log-date {
  display: block;
  margin-top: 5rpx;
  color: #BBBBBB;
  font-size: 20rpx;
  letter-spacing: 1rpx;
}

.log-summary {
  display: block;
  margin-top: 16rpx;
  color: #1A1A1A;
  font-size: 26rpx;
  line-height: 1.75;
  letter-spacing: 0.5rpx;
}

.log-detail {
  display: block;
  margin-top: 8rpx;
  color: #888888;
  font-size: 23rpx;
  line-height: 1.65;
  letter-spacing: 0.5rpx;
}

/* 截图缩略图横向滚动 */
.log-thumbs {
  display: flex;
  white-space: nowrap;
  margin-top: 16rpx;
}

.log-thumb {
  display: inline-block;
  width: 120rpx;
  height: 120rpx;
  margin-right: 8rpx;
  flex: 0 0 120rpx;
  border: 1rpx solid #EBEBEB;
}

/* 底部分隔线（由 log-card border-bottom 承担） */
.log-divider {
  display: none;
}

/* 空状态 / 加载中 */
.logs-empty {
  padding: 48rpx 0;
  text-align: center;
}

.logs-empty-text {
  font-size: 24rpx;
  color: #BBBBBB;
  letter-spacing: 1rpx;
}
