.today-page {
  padding-bottom: 80rpx;
}

/* ─── Hero：文艺拼贴风 ─── */
.hero {
  display: flex;
  justify-content: space-between;
  align-items: stretch;
  gap: 20rpx;
  min-height: 290rpx;
  padding: 40rpx 32rpx 48rpx;
  border-radius: 32rpx;
  background: #FFFFFF;
  border: 1rpx solid #EBEBEB;
  overflow: visible;
  position: relative;
  box-shadow:
    0 4rpx 16rpx rgba(0, 0, 0, 0.05),
    0 16rpx 40rpx rgba(0, 0, 0, 0.04);
}

/* 纸纹横线（极淡，保留手帐感） */
.hero-lines {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  border-radius: 32rpx;
  overflow: hidden;
  pointer-events: none;
}

.hero-line {
  height: 48rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.04);
}

.hero-copy {
  flex: 1;
  position: relative;
  z-index: 1;
}

/* 日期：莫兰迪橙印章 */
.date-stamp {
  display: inline-flex;
  align-items: center;
  height: 42rpx;
  padding: 0 16rpx;
  border: 1.5rpx solid #D4896A;
  border-radius: 6rpx;
  color: #D4896A;
  font-size: 20rpx;
  font-weight: 700;
  font-style: italic;
  letter-spacing: 3rpx;
  margin-bottom: 20rpx;
  transform: rotate(-1.5deg);
  position: relative;
}

.date-stamp::before {
  content: "";
  position: absolute;
  inset: 3rpx;
  border: 1rpx solid rgba(212, 137, 106, 0.25);
  border-radius: 4rpx;
}

/* Hero 标题 */
.hero-title {
  font-size: 54rpx !important;
  font-weight: 700 !important;
  letter-spacing: 1rpx !important;
  line-height: 1.2 !important;
}

/* ─── Hero 插画区 ─── */
.hero-doodle {
  width: 186rpx;
  flex: 0 0 186rpx;
  align-self: center;
  height: 210rpx;
  position: relative;
  z-index: 1;
}

/* 主手帐卡片 */
.doodle-card {
  position: absolute;
  right: 0;
  top: 8rpx;
  width: 148rpx;
  height: 172rpx;
  border: 2rpx solid #5BAF85;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.92);
  transform: rotate(4deg);
  box-shadow:
    3rpx 6rpx 16rpx rgba(91, 175, 133, 0.12),
    0 1rpx 0 rgba(255,255,255,0.9) inset;
}

/* 卡片内横线 */
.doodle-line {
  width: 72rpx;
  height: 4rpx;
  border-radius: 999rpx;
  margin: 22rpx 0 0 22rpx;
  background: #C8E8D8;
}

.doodle-line.wide {
  width: 100rpx;
  margin-top: 38rpx;
}

/* 星形闪光 */
.doodle-spark {
  position: absolute;
  right: 18rpx;
  top: 16rpx;
  width: 22rpx;
  height: 22rpx;
}

.doodle-spark::before,
.doodle-spark::after {
  content: "";
  position: absolute;
  background: #D4896A;
  border-radius: 999rpx;
}

.doodle-spark::before {
  width: 22rpx;
  height: 2rpx;
  top: 50%;
  left: 0;
  transform: translateY(-50%);
}

.doodle-spark::after {
  width: 2rpx;
  height: 22rpx;
  left: 50%;
  top: 0;
  transform: translateX(-50%);
}

/* 小花 */
.doodle-flower {
  position: absolute;
  left: 20rpx;
  bottom: 22rpx;
  width: 52rpx;
  height: 52rpx;
}

.doodle-flower view {
  position: absolute;
  width: 20rpx;
  height: 20rpx;
  border: 2rpx solid #D4896A;
  border-radius: 50%;
}

.doodle-flower view:nth-child(1) { left: 16rpx; top: 0; }
.doodle-flower view:nth-child(2) { right: 0; top: 16rpx; }
.doodle-flower view:nth-child(3) { left: 16rpx; bottom: 0; }
.doodle-flower view:nth-child(4) { left: 0; top: 16rpx; }

/* 便签本 */
.doodle-pad {
  position: absolute;
  left: 4rpx;
  bottom: 0;
  width: 88rpx;
  height: 70rpx;
  border: 2rpx solid #C9A84C;
  border-radius: 16rpx;
  background: rgba(255, 248, 220, 0.85);
  transform: rotate(-7deg);
  box-shadow: 2rpx 5rpx 12rpx rgba(201, 168, 76, 0.15);
}

.doodle-pad::after {
  content: "";
  position: absolute;
  left: 14rpx;
  top: 20rpx;
  width: 50rpx;
  height: 3rpx;
  border-radius: 999rpx;
  background: rgba(201, 168, 76, 0.45);
  box-shadow: 0 14rpx 0 rgba(201, 168, 76, 0.3);
}

/* 回形针装饰 */
.doodle-clip {
  position: absolute;
  right: 56rpx;
  top: -14rpx;
  width: 18rpx;
  height: 44rpx;
  border: 2.5rpx solid #B0C4BC;
  border-radius: 999rpx;
  border-bottom: none;
}

.doodle-clip::after {
  content: "";
  position: absolute;
  left: 3rpx;
  top: 6rpx;
  width: 8rpx;
  height: 28rpx;
  border: 2.5rpx solid #B0C4BC;
  border-radius: 999rpx;
  border-bottom: none;
}

/* ─── 快捷操作 ─── */
.quick-panel {
  display: flex;
  gap: 14rpx;
  margin-top: 28rpx;
}

.record-button {
  flex: 1;
}

.quick-actions {
  display: flex;
  gap: 10rpx;
  flex: 0 0 auto;
}

.quick-action {
  min-width: 110rpx;
  height: 92rpx;
  border: 1rpx solid #EBEBEB;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  background: #FFFFFF;
  color: #7A9088;
  font-size: 21rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

/* 快捷操作图标：相机 */
.quick-icon {
  width: 32rpx;
  height: 26rpx;
  position: relative;
}

.icon-camera {
  border: 2rpx solid #7A9088;
  border-radius: 6rpx;
}

.icon-camera::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 12rpx;
  height: 12rpx;
  border: 2rpx solid #7A9088;
  border-radius: 50%;
}

.icon-camera::after {
  content: "";
  position: absolute;
  left: 6rpx;
  top: -6rpx;
  width: 10rpx;
  height: 6rpx;
  border: 2rpx solid #7A9088;
  border-bottom: none;
  border-radius: 4rpx 4rpx 0 0;
}

/* 快捷操作图标：星星 */
.icon-star {
  width: 28rpx;
  height: 28rpx;
  border: 2rpx solid #C9A84C;
  transform: rotate(45deg);
  border-radius: 4rpx;
}

/* ─── 统计条 ─── */
.stats-strip {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
}

.stat-card {
  min-height: 158rpx;
  padding: 0 18rpx 20rpx;
  border: 1rpx solid #EBEBEB;
  border-radius: 24rpx;
  background: #FFFFFF;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  position: relative;
  overflow: hidden;
}

/* 卡片顶部彩色胶带（莫兰迪色） */
.stat-tape {
  height: 8rpx;
  margin: 0 20rpx 18rpx;
  border-radius: 0 0 6rpx 6rpx;
  background: #5BAF85;
  opacity: 0.6;
}

.stat-card:nth-child(2) .stat-tape { background: #D4896A; }
.stat-card:nth-child(3) .stat-tape { background: #C9A84C; }

.stat-value {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #1A2E22;
  letter-spacing: -1rpx;
}

.stat-label {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  font-weight: 600;
  color: #7A9088;
  letter-spacing: 1rpx;
}

.stat-hint {
  display: block;
  margin-top: 6rpx;
  color: #B0C4BC;
  font-size: 19rpx;
  line-height: 1.5;
}

/* ─── 最近在玩 ─── */
.game-row {
  width: 100%;
  white-space: nowrap;
}

.game-card {
  display: inline-block;
  width: 276rpx;
  margin-right: 16rpx;
  overflow: hidden;
  vertical-align: top;
  border: 1rpx solid #EBEBEB;
  border-radius: 28rpx;
  background: #FFFFFF;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.cover {
  height: 164rpx;
  padding: 22rpx;
  color: #FFFFFF;
  position: relative;
  overflow: hidden;
}

/* 胶片叠色：在封面色块上叠一层暖色渐变，模拟老照片感 */
.cover::before {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(
    135deg,
    rgba(255, 240, 210, 0.18) 0%,
    rgba(180, 120, 80, 0.12) 100%
  );
  mix-blend-mode: multiply;
  z-index: 1;
}

/* 封面右下角大圆 */
.cover::after {
  content: "";
  position: absolute;
  right: -36rpx;
  bottom: -36rpx;
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
  z-index: 2;
}

.cover-noise {
  position: absolute;
  left: 22rpx;
  bottom: 18rpx;
  width: 56rpx;
  height: 3rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.45);
  z-index: 3;
}

.cover-title {
  display: block;
  max-width: 196rpx;
  white-space: normal;
  font-size: 26rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  line-height: 1.3;
  position: relative;
  z-index: 3;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
}

/* 封面线条小人 */
.cover-figure {
  position: absolute;
  right: 18rpx;
  bottom: 22rpx;
  width: 24rpx;
  height: 36rpx;
  z-index: 3;
}

.cover-figure::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 0;
  transform: translateX(-50%);
  width: 12rpx;
  height: 12rpx;
  border: 2rpx solid rgba(255,255,255,0.65);
  border-radius: 50%;
}

.cover-figure::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 14rpx;
  transform: translateX(-50%);
  width: 2rpx;
  height: 14rpx;
  background: rgba(255,255,255,0.65);
  border-radius: 999rpx;
  box-shadow:
    -7rpx 6rpx 0 rgba(255,255,255,0.65),
     7rpx 6rpx 0 rgba(255,255,255,0.65),
    -6rpx 4rpx 0 rgba(255,255,255,0.65),
     6rpx 4rpx 0 rgba(255,255,255,0.65);
}

.game-meta {
  padding: 18rpx 18rpx 20rpx;
}

.game-title {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  white-space: normal;
  color: #1A2E22;
  letter-spacing: 0.5rpx;
}

.game-progress {
  display: block;
  margin-top: 8rpx;
  color: #9AADA6;
  font-size: 22rpx;
  letter-spacing: 0.5rpx;
}

.tag-line {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 14rpx;
}

/* ─── 今日碎片 ─── */
.log-card {
  padding: 0 26rpx 26rpx;
  margin-bottom: 20rpx;
  border-radius: 28rpx;
  position: relative;
  overflow: hidden;
}

/* 卡片顶部胶带（莫兰迪绿，更低调） */
.log-tape {
  height: 10rpx;
  width: 72rpx;
  margin: 0 auto 22rpx;
  border-radius: 0 0 8rpx 8rpx;
  background: rgba(91, 175, 133, 0.4);
  position: relative;
}

.log-tape::after {
  content: "";
  position: absolute;
  left: 10rpx;
  right: 10rpx;
  top: 2rpx;
  height: 2rpx;
  border-radius: 999rpx;
  background: rgba(255,255,255,0.5);
}

.log-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.log-game {
  display: block;
  font-size: 29rpx;
  font-weight: 700;
  color: #1A2E22;
  letter-spacing: 0.5rpx;
}

.log-date {
  display: block;
  margin-top: 6rpx;
  color: #B0C4BC;
  font-size: 21rpx;
  letter-spacing: 1rpx;
}

.log-summary {
  display: block;
  margin-top: 20rpx;
  color: #1A2E22;
  font-size: 27rpx;
  line-height: 1.75;           /* 更大行高，更透气 */
  letter-spacing: 0.5rpx;
}

.log-detail {
  display: block;
  margin-top: 10rpx;
  color: #9AADA6;
  font-size: 24rpx;
  line-height: 1.65;
  letter-spacing: 0.5rpx;
}

/* 底部虚线分割 */
.log-divider {
  margin-top: 22rpx;
  height: 2rpx;
  background: repeating-linear-gradient(
    90deg,
    #E0E0E0 0,
    #E0E0E0 6rpx,
    transparent 6rpx,
    transparent 14rpx
  );
  border-radius: 999rpx;
  opacity: 0.7;
}
