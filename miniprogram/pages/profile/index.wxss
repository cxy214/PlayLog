.profile-card {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 28rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #ffffff 0%, #edf8f5 100%);
}

.avatar {
  width: 112rpx;
  height: 112rpx;
  flex: 0 0 112rpx;
  border-radius: 30rpx;
  background: #172026;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  font-weight: 850;
}

.profile-copy {
  flex: 1;
}

.theme-row {
  display: flex;
  gap: 14rpx;
  overflow-x: auto;
}

.theme-chip {
  min-width: 190rpx;
  height: 86rpx;
  padding: 0 18rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
  color: #172026;
  font-size: 24rpx;
  font-weight: 750;
}

.theme-swatch {
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
}

.theme-0 {
  background: #0f766e;
}

.theme-1 {
  background: #ff7a45;
}

.theme-2 {
  background: #7d8790;
}

.action-list {
  padding: 0 22rpx;
  border-radius: 28rpx;
}

.action-item {
  min-height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 2rpx solid #eef1f4;
  font-size: 28rpx;
  font-weight: 700;
}

.action-item:last-child {
  border-bottom: 0;
}

.action-arrow {
  color: #a5afb7;
  font-size: 42rpx;
}

.note-card {
  padding: 24rpx;
  border-radius: 28rpx;
}

.note-title,
.note-text {
  display: block;
}

.note-title {
  font-size: 30rpx;
  font-weight: 800;
}

.note-text {
  margin-top: 12rpx;
  color: #69747c;
  font-size: 25rpx;
  line-height: 1.55;
}
