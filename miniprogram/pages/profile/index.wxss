/* ─── 我的页面 ─── */

/* ─── 个人卡片 ─── */
.profile-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 36rpx;
  border-radius: 32rpx;
  background: #FFFFFF;
  border: 1rpx solid #EBEBEB;
  position: relative;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

/* 背景横线（极淡，手帐感） */
.profile-card::before {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background-image: repeating-linear-gradient(
    transparent,
    transparent 47rpx,
    rgba(0, 0, 0, 0.035) 47rpx,
    rgba(0, 0, 0, 0.035) 48rpx
  );
  pointer-events: none;
}

/* 头像 */
.avatar {
  width: 108rpx;
  height: 108rpx;
  flex: 0 0 108rpx;
  border: 2rpx solid #5BAF85;
  border-radius: 24rpx;
  background: #F5F5F5;
  color: #5BAF85;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  font-weight: 700;
  box-shadow:
    0 4rpx 14rpx rgba(91, 175, 133, 0.15),
    0 1rpx 0 rgba(255,255,255,0.9) inset;
  position: relative;
  z-index: 1;
}

.profile-copy {
  flex: 1;
  position: relative;
  z-index: 1;
}

.profile-card .page-title {
  font-size: 40rpx;
}

/* 右上角星星（莫兰迪橙） */
.profile-spark {
  position: absolute;
  right: 32rpx;
  top: 28rpx;
  width: 26rpx;
  height: 26rpx;
  z-index: 1;
}

.profile-spark::before,
.profile-spark::after {
  content: "";
  position: absolute;
  background: #D4896A;
  border-radius: 999rpx;
}

.profile-spark::before {
  width: 26rpx;
  height: 2rpx;
  top: 50%;
  left: 0;
  transform: translateY(-50%);
}

.profile-spark::after {
  width: 2rpx;
  height: 26rpx;
  left: 50%;
  top: 0;
  transform: translateX(-50%);
}

/* ─── 主题选择 ─── */
.theme-row {
  display: flex;
  gap: 14rpx;
  overflow-x: auto;
}

.theme-chip {
  min-width: 186rpx;
  height: 88rpx;
  padding: 0 20rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  color: #1A2E22;
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  border: 1rpx solid #EBEBEB;
  border-radius: 20rpx;
  background: #FFFFFF;
  box-shadow: 0 3rpx 10rpx rgba(0, 0, 0, 0.04);
}

.theme-swatch {
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.1);
}

/* 莫兰迪色板 */
.theme-0 { background: linear-gradient(135deg, #5BAF85, #3D9068); }
.theme-1 { background: linear-gradient(135deg, #D4896A, #B86A4E); }
.theme-2 { background: linear-gradient(135deg, #B0C4BC, #8AA396); }

/* ─── 工具列表（竖线左侧装饰 + 疏朗留白） ─── */
.action-list {
  padding: 0 24rpx;
  border-radius: 28rpx;
}

.action-item {
  min-height: 100rpx;           /* 加高，更透气 */
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx dashed #E8E8E8;
  font-size: 27rpx;
  font-weight: 600;
  color: #1A2E22;
  letter-spacing: 0.5rpx;
  position: relative;
  padding-left: 20rpx;
}

/* 左侧竖线装饰（文艺感） */
.action-item::before {
  content: "";
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 2rpx;
  height: 28rpx;
  border-radius: 999rpx;
  background: #EBEBEB;
}

.action-item:last-child {
  border-bottom: 0;
}

.action-arrow {
  color: #CCCCCC;
  font-size: 36rpx;
  font-weight: 300;
}

/* ─── 备注卡片（莫兰迪黄竖条） ─── */
.note-card {
  padding: 28rpx 28rpx 28rpx 32rpx;
  border-radius: 28rpx;
  background: #FFFDF5;
  border: 1rpx solid rgba(201, 168, 76, 0.25);
  box-shadow:
    0 1rpx 0 rgba(255,255,255,0.9) inset,
    0 4rpx 14rpx rgba(201, 168, 76, 0.08);
  position: relative;
  overflow: hidden;
}

/* 左侧莫兰迪黄竖条 */
.note-card::before {
  content: "";
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 5rpx;
  background: #C9A84C;
  border-radius: 0 4rpx 4rpx 0;
}

.note-title {
  display: block;
  font-size: 27rpx;
  font-weight: 700;
  color: #1A2E22;
  letter-spacing: 1rpx;
}

.note-text {
  display: block;
  margin-top: 14rpx;
  color: #9AADA6;
  font-size: 25rpx;
  line-height: 1.75;
  letter-spacing: 0.5rpx;
}
