/* ─── 我的页面 ─── */

/* ─── 个人卡片：平面化，无圆角无阴影 ─── */
.profile-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 36rpx 0 36rpx;
  border-radius: 0;
  background: #FFFFFF;
  border: none;
  border-bottom: 1rpx solid #EBEBEB;
  position: relative;
  overflow: visible;
  box-shadow: none;
}

/* 去掉背景横线 */
.profile-card::before {
  display: none;
}

/* 头像：直角化 */
.avatar {
  width: 100rpx;
  height: 100rpx;
  flex: 0 0 100rpx;
  border: 1.5rpx solid #5BAF85;
  border-radius: 4rpx;           /* 微圆角，保留一点手帐感 */
  background: #F5F5F5;
  color: #5BAF85;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
  font-weight: 700;
  box-shadow: none;
  position: relative;
  z-index: 1;
}

.profile-copy {
  flex: 1;
  position: relative;
  z-index: 1;
}

.profile-card .page-title {
  font-size: 38rpx;
}

/* 右上角星星（保留，是手帐点缀） */
.profile-spark {
  position: absolute;
  right: 0;
  top: 32rpx;
  width: 24rpx;
  height: 24rpx;
  z-index: 1;
}

.profile-spark::before,
.profile-spark::after {
  content: "";
  position: absolute;
  background: #D4896A;
  border-radius: 0;
}

.profile-spark::before {
  width: 24rpx;
  height: 2rpx;
  top: 50%;
  left: 0;
  transform: translateY(-50%);
}

.profile-spark::after {
  width: 2rpx;
  height: 24rpx;
  left: 50%;
  top: 0;
  transform: translateX(-50%);
}

/* ─── 主题选择 ─── */
.theme-row {
  display: flex;
  gap: 12rpx;
  overflow-x: auto;
}

.theme-chip {
  min-width: 172rpx;
  height: 80rpx;
  padding: 0 18rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
  color: #1A1A1A;
  font-size: 23rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  border: 1rpx solid #EBEBEB;
  border-radius: 0;              /* 直角 */
  background: #FFFFFF;
  box-shadow: none;
}

.theme-swatch {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  box-shadow: none;
}

.theme-0 { background: linear-gradient(135deg, #5BAF85, #3D9068); }
.theme-1 { background: linear-gradient(135deg, #D4896A, #B86A4E); }
.theme-2 { background: linear-gradient(135deg, #B0C4BC, #8AA396); }

/* ─── 工具列表：喜茶风，细线分隔 ─── */
.action-list {
  padding: 0;
  border-radius: 0;
  border-top: 1rpx solid #EBEBEB;
}

.action-item {
  min-height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid #EBEBEB;
  font-size: 27rpx;
  font-weight: 600;
  color: #1A1A1A;
  letter-spacing: 0.5rpx;
  position: relative;
  padding: 0;
}

/* 去掉左侧竖线 */
.action-item::before {
  display: none;
}

.action-item:last-child {
  border-bottom: 0;
}

.action-arrow {
  color: #CCCCCC;
  font-size: 34rpx;
  font-weight: 300;
}

/* ─── 备注卡片：平面化，左侧莫兰迪黄竖条保留 ─── */
.note-card {
  padding: 24rpx 24rpx 24rpx 28rpx;
  border-radius: 0;
  background: #FFFDF5;
  border: none;
  border-top: 1rpx solid #EBEBEB;
  border-bottom: 1rpx solid #EBEBEB;
  box-shadow: none;
  position: relative;
  overflow: hidden;
}

/* 左侧莫兰迪黄竖条（保留，是手帐特色） */
.note-card::before {
  content: "";
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 4rpx;
  background: #C9A84C;
  border-radius: 0;
}

.note-title {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #1A1A1A;
  letter-spacing: 1rpx;
}

.note-text {
  display: block;
  margin-top: 12rpx;
  color: #888888;
  font-size: 24rpx;
  line-height: 1.75;
  letter-spacing: 0.5rpx;
}
