/* ─── 里程碑新建页 ─── */

.milestone-new-page {
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

/* 复用 record/new 的表单基础样式 */
.form-section { padding: 32rpx 0 24rpx; }
.form-divider { height: 1rpx; background: #EBEBEB; }

.form-label {
  font-size: 22rpx;
  font-weight: 700;
  color: #888888;
  letter-spacing: 2rpx;
  text-transform: uppercase;
  margin-bottom: 20rpx;
}

.form-label-opt {
  font-weight: 400;
  font-style: italic;
  color: #BBBBBB;
  letter-spacing: 0;
  text-transform: none;
}

.form-input {
  width: 100%;
  height: 80rpx;
  border: none;
  border-bottom: 1rpx solid #EBEBEB;
  border-radius: 0;
  background: transparent;
  color: #1A1A1A;
  font-size: 28rpx;
}

.form-textarea {
  width: 100%;
  min-height: 100rpx;
  padding: 16rpx 0;
  border: none;
  border-bottom: 1rpx solid #EBEBEB;
  border-radius: 0;
  background: transparent;
  color: #1A1A1A;
  font-size: 27rpx;
  line-height: 1.75;
}

.input-count {
  display: block;
  text-align: right;
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #BBBBBB;
}

/* ─── 游戏选择 ─── */
.game-selected {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #EBEBEB;
}

.game-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  flex: 0 0 12rpx;
}

.game-selected-info { flex: 1; min-width: 0; }

.game-selected-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #1A1A1A;
}

.game-selected-meta {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #888888;
}

.game-clear { font-size: 28rpx; color: #BBBBBB; padding: 8rpx; }

.shelf-chips { white-space: nowrap; }

.shelf-chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  height: 56rpx;
  padding: 0 18rpx;
  margin-right: 10rpx;
  border: 1rpx solid #EBEBEB;
  border-radius: 4rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.shelf-chip-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  flex: 0 0 10rpx;
}

.shelf-chip-empty { color: #BBBBBB; border-style: dashed; }

/* ─── 类型选择 ─── */
.type-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.type-chip {
  height: 60rpx;
  padding: 0 24rpx;
  border: 1rpx solid #EBEBEB;
  border-radius: 4rpx;
  background: #FFFFFF;
  color: #888888;
  font-size: 24rpx;
  font-weight: 600;
  font-style: italic;
  letter-spacing: 1rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.type-chip.active {
  background: #1A1A1A;
  border-color: #1A1A1A;
  color: #FFFFFF;
  font-weight: 700;
}

/* ─── 截图网格 ─── */
.screenshot-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8rpx;
}

.screenshot-item { position: relative; aspect-ratio: 1; overflow: hidden; }
.screenshot-img { width: 100%; height: 100%; display: block; }

.screenshot-del {
  position: absolute;
  top: 0; right: 0;
  width: 44rpx; height: 44rpx;
  background: rgba(0,0,0,0.65);
  color: #FFFFFF;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.screenshot-add {
  aspect-ratio: 1;
  border: 1rpx dashed #CCCCCC;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  background: #FAFAFA;
}

.screenshot-add-icon { font-size: 44rpx; color: #BBBBBB; line-height: 1; }
.screenshot-add-label { font-size: 20rpx; color: #BBBBBB; letter-spacing: 1rpx; }

/* ─── 提交区 ─── */
.submit-area {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  border-top: 1rpx solid #EBEBEB;
}

.submit-btn { width: 100%; height: 88rpx; font-size: 27rpx; letter-spacing: 4rpx; }
.submit-btn.disabled { background: #888888; }

.submit-hint {
  display: block;
  text-align: center;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #D4896A;
}
