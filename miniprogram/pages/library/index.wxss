/* ─── 游戏书架页 ─── */

.library-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  padding-bottom: 32rpx;
  border-bottom: 1rpx solid #EBEBEB;
}

/* ─── 书架插画（直角化） ─── */
.shelf-doodle {
  width: 120rpx;
  height: 110rpx;
  flex: 0 0 120rpx;
  position: relative;
}

.doodle-book {
  position: absolute;
  right: 4rpx;
  bottom: 6rpx;
  width: 58rpx;
  height: 86rpx;
  border: 1.5rpx solid #5BAF85;
  border-radius: 2rpx;           /* 直角 */
  background: rgba(240, 250, 245, 0.95);
  transform: rotate(6deg);
  box-shadow: none;
}

.doodle-book::before {
  content: "";
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 10rpx;
  border-radius: 0;
  background: rgba(91, 175, 133, 0.15);
}

.doodle-book::after {
  content: "";
  position: absolute;
  left: 16rpx;
  top: 16rpx;
  width: 24rpx;
  height: 2rpx;
  border-radius: 0;
  background: #C9A84C;
  box-shadow: 0 11rpx 0 rgba(201, 168, 76, 0.35);
}

.doodle-book.small {
  left: 6rpx;
  right: auto;
  bottom: 0;
  width: 50rpx;
  height: 68rpx;
  border-color: #D4896A;
  background: rgba(250, 242, 238, 0.95);
  transform: rotate(-5deg);
  box-shadow: none;
}

.doodle-book.small::before {
  background: rgba(212, 137, 106, 0.12);
}

.doodle-book.small::after {
  background: rgba(212, 137, 106, 0.3);
  width: 20rpx;
  box-shadow: 0 11rpx 0 rgba(212, 137, 106, 0.18);
}

/* ─── 筛选栏：喜茶风格，无背景色块 ─── */
.filter-bar {
  display: flex;
  gap: 0;
  margin-top: 28rpx;
  border-bottom: 1rpx solid #EBEBEB;
}

.filter-item {
  flex: 1;
  height: 72rpx;
  border-radius: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #888888;
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  position: relative;
}

/* 激活态：底部黑色下划线，喜茶风 */
.filter-item.active {
  color: #1A1A1A;
  font-weight: 700;
  background: transparent;
  box-shadow: none;
}

.filter-item.active::after {
  content: "";
  position: absolute;
  bottom: 0;
  left: 20%;
  right: 20%;
  height: 2rpx;
  background: #1A1A1A;
  border-radius: 0;
}

/* ─── 搜索区 ─── */
.search-card {
  margin-top: 24rpx;
  padding: 0;
  border: none;
  background: transparent;
  box-shadow: none;
  border-radius: 0;
}

.search-top {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.search-input {
  flex: 1;
  height: 80rpx;
  padding: 0 20rpx;
  border: 1rpx solid #EBEBEB;
  border-radius: 0;              /* 直角 */
  background: #FFFFFF;
  color: #1A1A1A;
  font-size: 26rpx;
  letter-spacing: 0.5rpx;
}

/* 搜索按钮：喜茶直角黑底 */
.search-button {
  width: 110rpx;
  height: 80rpx;
  border-radius: 0;
  background: #1A1A1A;
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 23rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
  box-shadow: none;
}

.search-error {
  display: block;
  margin: 12rpx 0 0;
  color: #D4896A;
  font-size: 22rpx;
}

.result-list {
  margin-top: 8rpx;
}

.result-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 116rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #EBEBEB;
}

.result-cover {
  width: 84rpx;
  height: 84rpx;
  flex: 0 0 84rpx;
  border-radius: 0;              /* 直角 */
  border: 1rpx solid #EBEBEB;
  background-color: #F5F5F5;
  background-size: cover;
  background-position: center;
}

.result-main {
  flex: 1;
  min-width: 0;
}

.result-title {
  display: block;
  color: #1A1A1A;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.4;
  letter-spacing: 0.5rpx;
}

.result-meta {
  display: block;
  margin-top: 6rpx;
  color: #888888;
  font-size: 21rpx;
  line-height: 1.4;
}

/* 加入按钮：直角黑底，喜茶风 */
.result-add {
  min-width: 80rpx;
  height: 52rpx;
  border-radius: 0;
  border: none;
  background: #1A1A1A;
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 21rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  position: relative;
}

.result-add::before {
  display: none;
}

/* ─── 书架列表 ─── */
.shelf {
  margin-top: 8rpx;
}

.shelf-card {
  display: flex;
  min-height: 200rpx;
  margin-bottom: 0;
  padding: 20rpx 0;
  gap: 18rpx;
  background: #FFFFFF;
  border-radius: 0;
  border: none;
  border-bottom: 1rpx solid #EBEBEB;
  box-shadow: none;
  overflow: hidden;
  position: relative;
}

/* 去掉右上角圆点 */
.shelf-card::after {
  display: none;
}

.cover-tile {
  width: 128rpx;
  min-height: 164rpx;
  flex: 0 0 128rpx;
  border-radius: 0;              /* 直角 */
  padding: 14rpx;
  color: #FFFFFF;
  font-size: 21rpx;
  font-weight: 700;
  line-height: 1.3;
  display: flex;
  align-items: flex-end;
  position: relative;
  overflow: hidden;
  box-shadow: none;
}

/* 胶片叠色保留 */
.cover-tile::before {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(
    135deg,
    rgba(255, 240, 210, 0.12) 0%,
    rgba(160, 100, 60, 0.08) 100%
  );
  mix-blend-mode: multiply;
  z-index: 1;
}

.cover-ring {
  position: absolute;
  right: -18rpx;
  top: -18rpx;
  width: 64rpx;
  height: 64rpx;
  border: 1.5rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  z-index: 2;
}

.cover-tile text {
  position: relative;
  z-index: 3;
  text-shadow: 0 1rpx 6rpx rgba(0, 0, 0, 0.3);
  letter-spacing: 0.5rpx;
}

.shelf-main {
  flex: 1;
  padding: 2rpx 0;
  min-width: 0;
}

.shelf-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
}

.shelf-title {
  flex: 1;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.35;
  color: #1A1A1A;
  letter-spacing: 0.5rpx;
}

/* 平台标签：小圆角印章，保留手帐感 */
.platform {
  min-width: 72rpx;
  height: 36rpx;
  border-radius: 4rpx;
  border: 1rpx solid #5BAF85;
  background: transparent;
  color: #5BAF85;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 16rpx;
  font-weight: 700;
  font-style: italic;
  text-transform: uppercase;
  letter-spacing: 2rpx;
  position: relative;
}

.platform::before {
  display: none;
}

.shelf-progress {
  display: block;
  margin-top: 10rpx;
  color: #5BAF85;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 0.5rpx;
}

.shelf-note {
  display: block;
  margin-top: 8rpx;
  color: #888888;
  font-size: 22rpx;
  line-height: 1.6;
  letter-spacing: 0.5rpx;
}

.tag-line {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 14rpx;
}

/* 书架底部：标签 + 状态 chip 同行 */
.shelf-bottom {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 12rpx;
}

/* 状态切换 chip */
.status-chip {
  flex: 0 0 auto;
  height: 40rpx;
  padding: 0 16rpx;
  border: 1rpx solid #EBEBEB;
  border-radius: 4rpx;
  font-size: 20rpx;
  font-weight: 700;
  font-style: italic;
  letter-spacing: 1rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #888888;
}

.status-chip.status-playing {
  border-color: #5BAF85;
  color: #5BAF85;
}

.status-chip.status-wishlist {
  border-color: #C9A84C;
  color: #C9A84C;
}

.status-chip.status-finished {
  border-color: #7B9EC9;
  color: #7B9EC9;
}

.status-chip.status-paused {
  border-color: #BBBBBB;
  color: #BBBBBB;
}

/* 搜索框右侧：清除 + 搜索按钮 */
.search-btn-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex: 0 0 auto;
}

.search-clear {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #BBBBBB;
}

/* 封面色块内文字 */
.cover-tile-title {
  position: relative;
  z-index: 3;
  font-size: 20rpx;
  font-weight: 700;
  color: #FFFFFF;
  text-shadow: 0 1rpx 6rpx rgba(0, 0, 0, 0.3);
  letter-spacing: 0.5rpx;
  word-break: break-all;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 空状态 / 加载中 */
.shelf-empty {
  padding: 80rpx 0;
  text-align: center;
}

.shelf-empty-text {
  font-size: 24rpx;
  color: #BBBBBB;
  letter-spacing: 1rpx;
}
