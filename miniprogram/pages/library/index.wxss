.filter-bar {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10rpx;
  margin-top: 32rpx;
  padding: 8rpx;
  border-radius: 24rpx;
  background: #e9eef2;
}

.filter-item {
  height: 62rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #667174;
  font-size: 24rpx;
  font-weight: 700;
}

.filter-item.active {
  background: #ffffff;
  color: #0f766e;
  box-shadow: 0 10rpx 24rpx rgba(19, 34, 43, 0.08);
}

.shelf {
  margin-top: 30rpx;
}

.shelf-card {
  display: flex;
  min-height: 222rpx;
  overflow: visible;
  margin-bottom: 18rpx;
  padding: 18rpx;
  gap: 18rpx;
}

.cover-tile {
  width: 142rpx;
  min-height: 186rpx;
  flex: 0 0 142rpx;
  border-radius: 24rpx;
  padding: 18rpx;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 850;
  line-height: 1.25;
  display: flex;
  align-items: flex-end;
  box-shadow: inset 0 -50rpx 80rpx rgba(23, 32, 38, 0.2);
}

.shelf-main {
  flex: 1;
  padding: 4rpx 0;
}

.shelf-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.shelf-title {
  flex: 1;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1.3;
}

.platform {
  min-width: 88rpx;
  height: 42rpx;
  border-radius: 999rpx;
  background: #172026;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: 700;
  text-transform: uppercase;
}

.shelf-progress,
.shelf-note {
  display: block;
}

.shelf-progress {
  margin-top: 10rpx;
  color: #0f766e;
  font-size: 24rpx;
  font-weight: 700;
}

.shelf-note {
  margin-top: 10rpx;
  color: #69747c;
  font-size: 24rpx;
  line-height: 1.45;
}

.tag-line {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 18rpx;
}

.add-button {
  margin-top: 34rpx;
}
