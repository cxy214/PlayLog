/* ─── 游戏书架页 ─── */

.library-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

/* ─── 书架插画 ─── */
.shelf-doodle {
  width: 130rpx;
  height: 120rpx;
  flex: 0 0 130rpx;
  position: relative;
}

/* 大书 */
.doodle-book {
  position: absolute;
  right: 4rpx;
  bottom: 6rpx;
  width: 62rpx;
  height: 92rpx;
  border: 2rpx solid #5BAF85;
  border-radius: 14rpx 14rpx 8rpx 8rpx;
  background: rgba(240, 250, 245, 0.95);
  transform: rotate(7deg);
  box-shadow:
    2rpx 5rpx 12rpx rgba(91, 175, 133, 0.12),
    0 1rpx 0 rgba(255,255,255,0.9) inset;
}

/* 书脊 */
.doodle-book::before {
  content: "";
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 11rpx;
  border-radius: 12rpx 0 0 6rpx;
  background: rgba(91, 175, 133, 0.18);
}

/* 书内横线 */
.doodle-book::after {
  content: "";
  position: absolute;
  left: 17rpx;
  top: 18rpx;
  width: 26rpx;
  height: 3rpx;
  border-radius: 999rpx;
  background: #C9A84C;
  box-shadow: 0 12rpx 0 rgba(201, 168, 76, 0.4);
}

/* 小书 */
.doodle-book.small {
  left: 8rpx;
  right: auto;
  bottom: 0;
  width: 54rpx;
  height: 74rpx;
  border-color: #D4896A;
  background: rgba(250, 242, 238, 0.95);
  transform: rotate(-6deg);
  box-shadow: 2rpx 5rpx 12rpx rgba(212, 137, 106, 0.1);
}

.doodle-book.small::before {
  background: rgba(212, 137, 106, 0.15);
}

.doodle-book.small::after {
  background: rgba(212, 137, 106, 0.35);
  width: 22rpx;
  box-shadow: 0 12rpx 0 rgba(212, 137, 106, 0.2);
}

/* ─── 筛选栏 ─── */
.filter-bar {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 8rpx;
  margin-top: 32rpx;
  padding: 7rpx;
  border: 1rpx solid #EBEBEB;
  border-radius: 16rpx;
  background: #F0F0F0;
}

.filter-item {
  height: 64rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #9AADA6;
  font-size: 23rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.filter-item.active {
  background: #FFFFFF;
  color: #1A2E22;
  font-weight: 700;
  box-shadow: 0 3rpx 10rpx rgba(0, 0, 0, 0.07);
}

/* ─── 搜索卡片 ─── */
.search-card {
  margin-top: 24rpx;
  padding: 18rpx;
}

.search-top {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.search-input {
  flex: 1;
  height: 80rpx;
  padding: 0 26rpx;
  border: 1rpx solid #EBEBEB;
  border-radius: 12rpx;
  background: #F5F5F5;
  color: #1A2E22;
  font-size: 26rpx;
  letter-spacing: 0.5rpx;
}

.search-button {
  width: 120rpx;
  height: 80rpx;
  border-radius: 12rpx;
  background: #1A2E22;
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
  box-shadow: 0 4rpx 0 #0D1A12;
}

.search-error {
  display: block;
  margin: 14rpx 8rpx 0;
  color: #D4896A;
  font-size: 23rpx;
}

.result-list {
  margin-top: 16rpx;
}

.result-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 120rpx;
  padding: 16rpx 6rpx;
  border-top: 1rpx dashed #E0E0E0;
}

.result-cover {
  width: 90rpx;
  height: 90rpx;
  flex: 0 0 90rpx;
  border-radius: 16rpx;
  border: 1rpx solid #EBEBEB;
  background-color: #F0F0F0;
  background-size: cover;
  background-position: center;
  /* 胶片叠色 */
  box-shadow: inset 0 0 0 1rpx rgba(255, 220, 180, 0.15);
}

.result-main {
  flex: 1;
  min-width: 0;
}

.result-title {
  display: block;
  color: #1A2E22;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 1.4;
  letter-spacing: 0.5rpx;
}

.result-meta {
  display: block;
  margin-top: 7rpx;
  color: #9AADA6;
  font-size: 22rpx;
  line-height: 1.4;
  letter-spacing: 0.5rpx;
}

/* 加入按钮：莫兰迪黄印章 */
.result-add {
  min-width: 76rpx;
  height: 50rpx;
  border-radius: 6rpx;
  border: 1.5rpx solid #C9A84C;
  background: transparent;
  color: #A07830;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 21rpx;
  font-weight: 700;
  font-style: italic;
  letter-spacing: 2rpx;
  position: relative;
}

.result-add::before {
  content: "";
  position: absolute;
  inset: 3rpx;
  border: 1rpx solid rgba(201, 168, 76, 0.2);
  border-radius: 4rpx;
}

/* ─── 书架列表 ─── */
.shelf {
  margin-top: 28rpx;
}

.shelf-card {
  display: flex;
  min-height: 210rpx;
  margin-bottom: 20rpx;
  padding: 18rpx;
  gap: 18rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  border: 1rpx solid #EBEBEB;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  overflow: hidden;
  position: relative;
}

/* 卡片右上角装饰：小圆点 */
.shelf-card::after {
  content: "";
  position: absolute;
  right: 22rpx;
  top: 22rpx;
  width: 7rpx;
  height: 7rpx;
  border-radius: 50%;
  background: #DEDEDE;
}

.cover-tile {
  width: 136rpx;
  min-height: 174rpx;
  flex: 0 0 136rpx;
  border-radius: 20rpx;
  padding: 16rpx;
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.3;
  display: flex;
  align-items: flex-end;
  position: relative;
  overflow: hidden;
  box-shadow: inset 0 -60rpx 80rpx rgba(0, 0, 0, 0.2);
}

/* 封面胶片叠色 */
.cover-tile::before {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(
    135deg,
    rgba(255, 240, 210, 0.15) 0%,
    rgba(160, 100, 60, 0.1) 100%
  );
  mix-blend-mode: multiply;
  z-index: 1;
}

.cover-ring {
  position: absolute;
  right: -22rpx;
  top: -22rpx;
  width: 76rpx;
  height: 76rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.25);
  border-radius: 50%;
  z-index: 2;
}

.cover-tile text {
  position: relative;
  z-index: 3;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
  letter-spacing: 0.5rpx;
}

.shelf-main {
  flex: 1;
  padding: 4rpx 0;
  min-width: 0;
}

.shelf-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
}

.shelf-title {
  flex: 1;
  font-size: 29rpx;
  font-weight: 700;
  line-height: 1.35;
  color: #1A2E22;
  letter-spacing: 0.5rpx;
}

/* 平台标签：莫兰迪绿印章 + 斜体 */
.platform {
  min-width: 80rpx;
  height: 38rpx;
  border-radius: 6rpx;
  border: 1.5rpx solid #5BAF85;
  background: transparent;
  color: #5BAF85;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 17rpx;
  font-weight: 700;
  font-style: italic;
  text-transform: uppercase;
  letter-spacing: 2rpx;
  position: relative;
}

.platform::before {
  content: "";
  position: absolute;
  inset: 3rpx;
  border: 1rpx solid rgba(91, 175, 133, 0.2);
  border-radius: 4rpx;
}

.shelf-progress {
  display: block;
  margin-top: 10rpx;
  color: #5BAF85;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 0.5rpx;
}

.shelf-note {
  display: block;
  margin-top: 10rpx;
  color: #9AADA6;
  font-size: 23rpx;
  line-height: 1.6;
  letter-spacing: 0.5rpx;
}

.tag-line {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 16rpx;
}

.add-button {
  margin-top: 32rpx;
}
