/* ─── 新建游玩记录表单页 ─── */

.record-page {
  padding-bottom: 120rpx;
}

/* ─── 表单分区 ─── */
.form-section {
  padding: 32rpx 0 24rpx;
}

.form-divider {
  height: 1rpx;
  background: #EBEBEB;
  margin: 0;
}

.form-label {
  font-size: 22rpx;
  font-weight: 700;
  color: #888888;
  letter-spacing: 2rpx;
  text-transform: uppercase;
  margin-bottom: 20rpx;
}

.form-label-opt {
  font-weight: 400;
  font-style: italic;
  color: #BBBBBB;
  letter-spacing: 0;
  text-transform: none;
}

/* ─── 输入框 ─── */
.form-input {
  width: 100%;
  height: 80rpx;
  padding: 0 0;
  border: none;
  border-bottom: 1rpx solid #EBEBEB;
  border-radius: 0;
  background: transparent;
  color: #1A1A1A;
  font-size: 28rpx;
  letter-spacing: 0.5rpx;
}

.form-textarea {
  width: 100%;
  min-height: 120rpx;
  padding: 16rpx 0;
  border: none;
  border-bottom: 1rpx solid #EBEBEB;
  border-radius: 0;
  background: transparent;
  color: #1A1A1A;
  font-size: 27rpx;
  line-height: 1.75;
  letter-spacing: 0.5rpx;
}

.input-count {
  display: block;
  text-align: right;
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #BBBBBB;
}

/* ─── 游戏搜索 ─── */
.search-row {
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.search-btn {
  flex: 0 0 auto;
  width: 100rpx;
  height: 80rpx;
  background: #1A1A1A;
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  border-radius: 0;
}

/* 搜索结果列表 */
.search-results {
  margin-top: 8rpx;
  border-top: 1rpx solid #EBEBEB;
}

.search-result-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #EBEBEB;
}

.result-cover-sm {
  width: 64rpx;
  height: 64rpx;
  flex: 0 0 64rpx;
  border-radius: 0;
  border: 1rpx solid #EBEBEB;
}

.result-info {
  flex: 1;
  min-width: 0;
}

.result-title-sm {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #1A1A1A;
  letter-spacing: 0.5rpx;
}

.result-meta-sm {
  display: block;
  margin-top: 4rpx;
  font-size: 21rpx;
  color: #888888;
}

.result-pick {
  font-size: 22rpx;
  font-weight: 700;
  font-style: italic;
  color: #5BAF85;
  letter-spacing: 1rpx;
  border: 1rpx solid #5BAF85;
  border-radius: 4rpx;
  padding: 6rpx 16rpx;
}

/* 从书架选 */
.shelf-pick-row {
  margin-top: 24rpx;
}

.shelf-pick-label {
  font-size: 21rpx;
  color: #BBBBBB;
  letter-spacing: 1rpx;
  display: block;
  margin-bottom: 14rpx;
}

.shelf-chips {
  white-space: nowrap;
}

.shelf-chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  height: 56rpx;
  padding: 0 18rpx;
  margin-right: 10rpx;
  border: 1rpx solid #EBEBEB;
  border-radius: 4rpx;
  background: #FFFFFF;
  font-size: 24rpx;
  font-weight: 600;
  color: #1A1A1A;
  letter-spacing: 0.5rpx;
}

.shelf-chip-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  flex: 0 0 10rpx;
}

/* 已选游戏展示 */
.game-selected {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #EBEBEB;
}

.game-selected-cover {
  width: 64rpx;
  height: 64rpx;
  flex: 0 0 64rpx;
  border-radius: 0;
}

.game-selected-info {
  flex: 1;
  min-width: 0;
}

.game-selected-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #1A1A1A;
}

.game-selected-meta {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #888888;
}

.game-selected-clear {
  font-size: 28rpx;
  color: #BBBBBB;
  padding: 8rpx;
}

/* ─── 心情标签 ─── */
.mood-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.mood-chip {
  height: 60rpx;
  padding: 0 24rpx;
  border: 1rpx solid #EBEBEB;
  border-radius: 4rpx;
  background: #FFFFFF;
  color: #888888;
  font-size: 24rpx;
  font-weight: 600;
  font-style: italic;
  letter-spacing: 1rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.15s;
}

/* 激活：黑底白字，喜茶风 */
.mood-chip.active {
  background: #1A1A1A;
  border-color: #1A1A1A;
  color: #FFFFFF;
  font-weight: 700;
}

/* ─── 提交区 ─── */
.submit-area {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  border-top: 1rpx solid #EBEBEB;
}

.submit-btn {
  width: 100%;
  height: 88rpx;
  font-size: 27rpx;
  letter-spacing: 4rpx;
}

.submit-btn.disabled {
  background: #888888;
}

.submit-hint {
  display: block;
  text-align: center;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #D4896A;
}
