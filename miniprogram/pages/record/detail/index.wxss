/* ─── 记录详情页 ─── */

.detail-page {
  padding-bottom: 120rpx;
}

/* 加载 / 未找到 */
.state-center {
  padding: 120rpx 0;
  text-align: center;
}

.state-text {
  font-size: 26rpx;
  color: #BBBBBB;
  letter-spacing: 1rpx;
}

/* ─── 顶部 Hero ─── */
.detail-hero {
  padding: 40rpx 0 40rpx 28rpx;
  border-bottom: 1rpx solid #EBEBEB;
}

.detail-game {
  font-size: 36rpx;
  font-weight: 800;
  color: #1A1A1A;
  letter-spacing: 1rpx;
  line-height: 1.3;
}

.detail-meta-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 12rpx;
}

.detail-date {
  font-size: 22rpx;
  color: #BBBBBB;
  letter-spacing: 1rpx;
}

.detail-progress {
  font-size: 22rpx;
  color: #888888;
  letter-spacing: 0.5rpx;
  padding: 2rpx 12rpx;
  border: 1rpx solid #EBEBEB;
}

/* 心情标签：印章风，带颜色边框 */
.detail-mood-chip {
  display: inline-block;
  margin-top: 20rpx;
  padding: 6rpx 20rpx;
  border: 1rpx solid #5BAF85;
  border-radius: 4rpx;
  font-size: 22rpx;
  font-weight: 700;
  font-style: italic;
  letter-spacing: 2rpx;
  color: #5BAF85;
}

/* ─── 分区 ─── */
.detail-divider {
  height: 1rpx;
  background: #EBEBEB;
}

.detail-section {
  padding: 32rpx 0 28rpx;
}

.detail-label {
  font-size: 20rpx;
  font-weight: 700;
  color: #AAAAAA;
  letter-spacing: 2rpx;
  text-transform: uppercase;
  margin-bottom: 18rpx;
}

.detail-label-count {
  font-weight: 400;
  font-style: italic;
  letter-spacing: 0;
  text-transform: none;
}

.detail-summary {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
  line-height: 1.8;
  letter-spacing: 0.5rpx;
}

.detail-body {
  display: block;
  font-size: 26rpx;
  color: #555555;
  line-height: 1.85;
  letter-spacing: 0.5rpx;
}

/* ─── 截图网格 ─── */
.detail-img-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 6rpx;
}

.detail-img {
  width: 100%;
  aspect-ratio: 1;
  display: block;
}

/* ─── 底部操作 ─── */
.detail-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  border-top: 1rpx solid #EBEBEB;
  display: flex;
  justify-content: center;
}

.detail-del-btn {
  font-size: 24rpx;
  color: #BBBBBB;
  letter-spacing: 2rpx;
  padding: 12rpx 32rpx;
  border: 1rpx solid #EBEBEB;
}
