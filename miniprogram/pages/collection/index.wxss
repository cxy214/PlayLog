/* ─── 游戏邮册页 ─── */

.collection-page {
  padding-bottom: 160rpx;
}

/* ─── 页头 ─── */
.collection-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
  padding-bottom: 32rpx;
  border-bottom: 1rpx solid #EBEBEB;
}

/* 风格切换按钮 */
.style-switch {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 10rpx 20rpx;
  border: 1rpx solid #EBEBEB;
  border-radius: 4rpx;
  flex: 0 0 auto;
  margin-top: 8rpx;
}

.style-switch-label {
  font-size: 22rpx;
  font-weight: 700;
  font-style: italic;
  color: #888888;
  letter-spacing: 1rpx;
}

.style-switch-icon {
  font-size: 22rpx;
  color: #BBBBBB;
}

/* ─── 类型筛选 Tab ─── */
.category-row {
  display: flex;
  white-space: nowrap;
  border-bottom: 1rpx solid #EBEBEB;
  margin-bottom: 0;
}

.category-pill {
  display: inline-flex;
  flex: 0 0 auto;
  min-width: 88rpx;
  height: 72rpx;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 600;
  font-style: italic;
  color: #888888;
  letter-spacing: 1rpx;
  padding: 0 16rpx;
  position: relative;
  border-radius: 0;
}

.category-pill.active {
  color: #1A1A1A;
  font-weight: 700;
}

.category-pill.active::after {
  content: "";
  position: absolute;
  bottom: 0;
  left: 16rpx;
  right: 16rpx;
  height: 2rpx;
  background: #1A1A1A;
}

/* ─── 空状态 ─── */
.state-empty {
  padding: 100rpx 0;
  text-align: center;
}

.state-empty-text {
  font-size: 24rpx;
  color: #BBBBBB;
  letter-spacing: 1rpx;
}

/* ══════════════════════════════════════════════
   风格一：邮票网格
══════════════════════════════════════════════ */

.stamp-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
  padding: 32rpx 0;
}

.stamp-wrap {
  display: flex;
  justify-content: center;
}

/* 邮票主体 */
.stamp {
  width: 100%;
  background: #FFFFFF;
  /* 锯齿边框：用 radial-gradient 模拟邮票齿孔 */
  --tooth: 10rpx;
  --gap: 6rpx;
  padding: var(--tooth);
  position: relative;
  /* 外层锯齿 mask */
  -webkit-mask-image:
    radial-gradient(circle at 0 0, transparent var(--tooth), #000 var(--tooth)),
    radial-gradient(circle at 100% 0, transparent var(--tooth), #000 var(--tooth)),
    radial-gradient(circle at 0 100%, transparent var(--tooth), #000 var(--tooth)),
    radial-gradient(circle at 100% 100%, transparent var(--tooth), #000 var(--tooth)),
    repeating-linear-gradient(90deg, transparent 0, transparent var(--gap), #000 var(--gap), #000 calc(var(--gap) + var(--tooth) * 1.2)),
    repeating-linear-gradient(0deg, transparent 0, transparent var(--gap), #000 var(--gap), #000 calc(var(--gap) + var(--tooth) * 1.2));
  -webkit-mask-composite: destination-in;
  mask-composite: intersect;
  /* 细边框 */
  border: 1rpx solid #EBEBEB;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}

/* 图片区：正方形 */
.stamp-img-area {
  width: 100%;
  aspect-ratio: 1;
  position: relative;
  overflow: hidden;
  background: #F5F5F5;
}

.stamp-img {
  width: 100%;
  height: 100%;
  display: block;
}

.stamp-no-img {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.stamp-type-text {
  font-size: 28rpx;
  font-weight: 800;
  font-style: italic;
  color: rgba(255,255,255,0.9);
  letter-spacing: 2rpx;
}

/* 右上角类型印章 */
.stamp-badge {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  padding: 4rpx 10rpx;
  background: rgba(0,0,0,0.55);
  color: #FFFFFF;
  font-size: 18rpx;
  font-weight: 700;
  font-style: italic;
  letter-spacing: 1rpx;
  border-radius: 2rpx;
}

/* 底部信息区 */
.stamp-info {
  padding: 12rpx 8rpx 8rpx;
  border-top: 1rpx dashed #EBEBEB;
  margin-top: 8rpx;
}

.stamp-game {
  display: block;
  font-size: 18rpx;
  color: #BBBBBB;
  letter-spacing: 1rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.stamp-title {
  display: block;
  font-size: 22rpx;
  font-weight: 700;
  color: #1A1A1A;
  letter-spacing: 0.5rpx;
  margin-top: 4rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.stamp-date {
  display: block;
  font-size: 18rpx;
  color: #BBBBBB;
  margin-top: 6rpx;
  font-style: italic;
  letter-spacing: 1rpx;
}

/* ══════════════════════════════════════════════
   风格二：拍立得
══════════════════════════════════════════════ */

.polaroid-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 32rpx;
  padding: 32rpx 0;
}

.polaroid-wrap {
  display: flex;
  justify-content: center;
}

.polaroid {
  width: 100%;
  background: #FFFFFF;
  border: 1rpx solid #E8E8E8;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.08);
  padding: 12rpx 12rpx 0;
  /* 随机轻微旋转感：用 nth-child 模拟 */
}

.polaroid-wrap:nth-child(odd) .polaroid {
  transform: rotate(-1.5deg);
}

.polaroid-wrap:nth-child(even) .polaroid {
  transform: rotate(1.2deg);
}

.polaroid-img-area {
  width: 100%;
  aspect-ratio: 1;
  overflow: hidden;
  background: #F5F5F5;
}

.polaroid-img { width: 100%; height: 100%; display: block; }

.polaroid-no-img {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.polaroid-type-text {
  font-size: 28rpx;
  font-weight: 800;
  font-style: italic;
  color: rgba(255,255,255,0.9);
}

.polaroid-info {
  padding: 16rpx 8rpx 20rpx;
}

.polaroid-title {
  display: block;
  font-size: 22rpx;
  font-weight: 700;
  color: #1A1A1A;
  letter-spacing: 0.5rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.polaroid-meta {
  display: block;
  margin-top: 6rpx;
  font-size: 18rpx;
  color: #BBBBBB;
  letter-spacing: 0.5rpx;
}

/* ══════════════════════════════════════════════
   风格三：胶卷
══════════════════════════════════════════════ */

.film-list {
  padding: 32rpx 0;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.film-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

/* 胶卷帧 */
.film-frame {
  flex: 0 0 160rpx;
  display: flex;
  align-items: center;
  gap: 0;
  background: #1A1A1A;
  padding: 8rpx 0;
}

.film-holes {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 0 6rpx;
}

.film-hole {
  width: 10rpx;
  height: 10rpx;
  border-radius: 2rpx;
  background: #444444;
}

.film-img-area {
  flex: 1;
  aspect-ratio: 1;
  overflow: hidden;
  background: #333333;
}

.film-img { width: 100%; height: 100%; display: block; }

.film-no-img {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.film-type-text {
  font-size: 20rpx;
  font-weight: 800;
  font-style: italic;
  color: rgba(255,255,255,0.7);
}

.film-info {
  flex: 1;
  min-width: 0;
}

.film-title {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #1A1A1A;
  letter-spacing: 0.5rpx;
}

.film-meta {
  display: block;
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #888888;
  letter-spacing: 0.5rpx;
}

/* ─── 浮动新建按钮 ─── */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: calc(120rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 112rpx;
  background: #1A1A1A;
  border-radius: 0;
  gap: 4rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.18);
}

.fab-icon {
  font-size: 36rpx;
  color: #FFFFFF;
  line-height: 1;
}

.fab-label {
  font-size: 18rpx;
  color: rgba(255,255,255,0.8);
  letter-spacing: 2rpx;
}
