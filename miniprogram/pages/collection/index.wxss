/* ─── 收藏柜页 ─── */

.collection-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

/* ─── 盲盒插画（莫兰迪色调） ─── */
.box-doodle {
  width: 126rpx;
  height: 122rpx;
  flex: 0 0 126rpx;
  position: relative;
}

.box-lid {
  position: absolute;
  left: 18rpx;
  top: 14rpx;
  width: 88rpx;
  height: 30rpx;
  border: 2rpx solid #C9A84C;
  border-radius: 10rpx;
  background: rgba(255, 248, 220, 0.85);
  transform: rotate(-5deg);
  box-shadow: 2rpx 3rpx 8rpx rgba(201, 168, 76, 0.15);
}

.box-lid::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 18rpx;
  height: 18rpx;
  border: 1.5rpx solid #A07830;
  border-radius: 50%;
}

.box-body {
  position: absolute;
  left: 12rpx;
  bottom: 8rpx;
  width: 100rpx;
  height: 72rpx;
  border: 2rpx solid #5BAF85;
  border-radius: 14rpx;
  background: rgba(240, 250, 245, 0.88);
  box-shadow: 2rpx 4rpx 12rpx rgba(91, 175, 133, 0.1);
}

.box-body::before {
  content: "✦";
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  font-size: 26rpx;
  color: #5BAF85;
  opacity: 0.45;
}

.box-body::after {
  content: "";
  position: absolute;
  right: 12rpx;
  top: 10rpx;
  width: 14rpx;
  height: 14rpx;
  border: 1.5rpx solid #D4896A;
  border-radius: 50%;
}

/* ─── 分类 Pill（莫兰迪印章） ─── */
.category-row {
  display: flex;
  gap: 12rpx;
  margin-top: 32rpx;
  overflow-x: auto;
}

.category-pill {
  flex: 0 0 auto;
  min-width: 108rpx;
  height: 58rpx;
  border-radius: 8rpx;
  border: 1.5rpx solid #DEDEDE;
  background: #FFFFFF;
  color: #9AADA6;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 23rpx;
  font-weight: 600;
  font-style: italic;
  letter-spacing: 2rpx;
  position: relative;
}

.category-pill::before {
  content: "";
  position: absolute;
  inset: 3rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.05);
  border-radius: 6rpx;
}

.category-pill.active {
  border-color: #1A2E22;
  background: #1A2E22;
  color: #FFFFFF;
  font-weight: 700;
  box-shadow: 0 3rpx 0 #0D1A12;
}

.category-pill.active::before {
  border-color: rgba(255,255,255,0.12);
}

/* ─── 收藏柜网格 ─── */
.cabinet {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  margin-top: 28rpx;
  margin-bottom: 32rpx;
}

.collection-card {
  overflow: hidden;
  border-radius: 24rpx;
  border: 1rpx solid #EBEBEB;
  background: #FFFFFF;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

/* ─── 展示区 ─── */
.item-display {
  height: 186rpx;
  position: relative;
  overflow: hidden;
}

/* 胶片叠色 */
.item-display::before {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(
    135deg,
    rgba(255, 240, 210, 0.15) 0%,
    rgba(0, 0, 0, 0.08) 100%
  );
  z-index: 1;
}

/* 展示区底部渐变 */
.item-display::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 60rpx;
  background: linear-gradient(to top, rgba(0,0,0,0.08), transparent);
  z-index: 2;
}

.display-shine {
  position: absolute;
  left: 18rpx;
  top: 18rpx;
  width: 36rpx;
  height: 68rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.25);
  z-index: 3;
}

.display-sticker {
  position: absolute;
  right: 16rpx;
  top: 16rpx;
  width: 34rpx;
  height: 34rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.45);
  border-radius: 50%;
  z-index: 3;
}

.display-sticker::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.5);
}

/* ─── 卡片信息区 ─── */
.item-body {
  min-height: 128rpx;
  padding: 16rpx 16rpx 18rpx;
}

.item-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 10rpx;
}

.item-name {
  flex: 1;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.35;
  color: #1A2E22;
  letter-spacing: 0.5rpx;
}

.item-series {
  display: block;
  margin-top: 10rpx;
  color: #B0C4BC;
  font-size: 21rpx;
  line-height: 1.4;
  letter-spacing: 0.5rpx;
}
